# Server port (binds 0.0.0.0)
PORT=3000
# Directory for the SQLite database
DATA_DIR=./data
# Default per-wallet poll interval in seconds (10 | 30 | 60)
POLL_INTERVAL=30
# How many days of trade history to fetch when a trader is first added
INITIAL_HISTORY_DAYS=31
# Max trades to backfill on first add (safety cap)
INITIAL_MAX_TRADES=2500
